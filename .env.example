NODE_ENV=development
# Postgres connection URL. Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/andalucia_joyeria

# JWT secret for admin auth (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_value

# Cloudinary (optional, required only for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin user used by the seed script
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Development helpers (never enable these in production)
# If DB_SYNC=true the app will run sequelize.sync() at startup
DB_SYNC=true
DB_SYNC_ALTER=true

# DB pool maximum connections (keep low for serverless)
DB_POOL_MAX=2
